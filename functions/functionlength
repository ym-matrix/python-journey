# Count the items in a list and describe its length
def length(lst):
    count = 0
    # Increment the count once for each item
    for num in lst:
        count += 1
    # Return a message based on whether the list has at least five items
    if count >= 5:
        return "Longer than 5"
    else:
        return "Less than 5"


# Example list to check
numbers = [1, 4, 5, 2, 8]
# Print the length description
print(length(numbers))